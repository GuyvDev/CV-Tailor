LLM_PROVIDER=auto
OPENAI_API_KEY=
ABACUS_API_KEY=
ABACUS_BASE_URL=https://routellm.abacus.ai/v1
MODEL_NAME=gpt-5-mini
OPENAI_REASONING_EFFORT=medium
CODEX_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_SECONDS=240
AUTO_PROVIDER_ORDER=codex,abacus
MAX_COMPILE_RETRIES=4
MAX_GENERATOR_RETRIES=3
MAX_SCORER_RETRIES=3
PROFILE_DIR=/app/data/profile
OUTPUT_DIR=/app/outputs
COMPILER_URL=http://typst-compiler:8001
PUBLIC_BASE_URL=http://localhost:8000
OUTPUT_BASENAME=tailored-resume
FRONTEND_PORT=3000
API_PORT=8000
COMPILER_PORT=8001
ENABLE_DEMO_MODE=true

# Stateful production settings
APP_ENV=development
REQUIRE_API_AUTH=false
API_AUTH_TOKEN=
API_ALLOWED_ORIGINS=http://localhost:3000
API_ENABLE_DOCS=true
API_PUBLIC_FILES_ENABLED=true
DOCKER_DNS_1=1.1.1.1
DOCKER_DNS_2=8.8.8.8

# Private Telegram workflow
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
API_URL=http://api:8000

# Stateless VPS mode (Gemini Flash by default)
FLASH_API_KEY=
STATELESS_ONLY=false
STATELESS_LLM_PROVIDER=gemini
STATELESS_MODEL_NAME=gemini-2.5-flash
STATELESS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
STATELESS_REASONING_EFFORT=medium
STATELESS_ENABLE_DEMO_MODE=false
VITE_STATELESS_ONLY=false
VITE_DEMO_VIDEO_URL=

# Optional durable cross-instance limits for public stateless Vercel generation.
# Server-side only; never use VITE_ prefixes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production hardening: set APP_ENV=production, REQUIRE_API_AUTH=true,
# and explicitly allow your frontend origin.
# For public deployments, prefer STATELESS_ONLY=true and API_PUBLIC_FILES_ENABLED=false.
