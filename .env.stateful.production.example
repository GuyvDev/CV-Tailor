# Copy to .env.stateful.production and fill in private values.
# Run with:
# docker compose --env-file .env.stateful.production -f docker-compose.stateful.prod.yml up --build -d

STATEFUL_DOMAIN=cv.example.com
STATEFUL_BASIC_AUTH_USER=admin
# Generate with: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'change-this-password'
STATEFUL_BASIC_AUTH_HASH=replace_with_caddy_hash

# Separate production data by default. This does not touch ./data or ./outputs used by docker-compose.yml.
STATEFUL_DATA_DIR=./data.prod
STATEFUL_OUTPUT_DIR=./outputs.prod

PUBLIC_BASE_URL=https://cv.example.com
# Public MP4 URL for the optional product walkthrough shown on the stateful homepage.
VITE_DEMO_VIDEO_URL=
LLM_PROVIDER=auto
OPENAI_API_KEY=
ABACUS_API_KEY=
ABACUS_BASE_URL=https://routellm.abacus.ai/v1
MODEL_NAME=gpt-5-mini
OPENAI_REASONING_EFFORT=low
CODEX_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_SECONDS=240
AUTO_PROVIDER_ORDER=codex,abacus
ENABLE_DEMO_MODE=false
MAX_COMPILE_RETRIES=4
MAX_GENERATOR_RETRIES=2
MAX_SCORER_RETRIES=2
OUTPUT_BASENAME=tailored-resume

# Optional Telegram profile: add --profile telegram to the docker compose command.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

DOCKER_DNS_1=1.1.1.1
DOCKER_DNS_2=8.8.8.8
HTTP_PORT=80
HTTPS_PORT=443
